# Copy to .env.local for local dev. On Vercel add the same two variables under
# Project → Settings → Environment Variables (Production, Preview and Development).
#
# Both values are PUBLIC by design (they end up in the browser bundle).
# Find them in Supabase Dashboard → Project Settings → API (or "API Keys").
# NEVER put the service_role / secret key here or anywhere in this repo.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
